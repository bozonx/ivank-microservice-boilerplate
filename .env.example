###### Basic app settings

# Application environment: development | production | test.
# Affects log formatting and health-check auto-logging. Defaults to production.
NODE_ENV=development

# Address the HTTP server binds to.
# Use localhost for local development and 0.0.0.0 inside a container.
LISTEN_HOST=localhost

# Port the HTTP server binds to.
LISTEN_PORT=8080

# Optional path prefix. When set, the API is served at {BASE_PATH}/api/v1
# instead of /api/v1. Leave empty unless the service sits behind a proxy that
# routes by path without stripping the prefix.
# BASE_PATH=

# Pino log level: trace | debug | info | warn | error | fatal | silent.
LOG_LEVEL=debug

# Application timezone. Keep UTC so logs and timestamps are comparable across hosts.
TZ=UTC

# Overrides the built-in service name used in logs and the health response.
# Leave unset unless several instances of this service must be told apart.
# SERVICE_NAME=

# Overrides the service version reported in logs and health. Normally set by the image from
# the APP_VERSION build arg; leave unset locally, where it reads "dev".
# SERVICE_VERSION=

# Seconds to keep serving after SIGTERM while health already reports "shutting_down".
# Gives the load balancer time to stop routing here before the process exits.
# Must stay below stop_grace_period in docker-compose.yml. 0 shuts down immediately.
SHUTDOWN_DRAIN_SECONDS=5

# Seconds to wait for a clean close before exiting with a failure status. Guards against a
# shutdown that never finishes: without it the process would hang until the orchestrator
# SIGKILLs it, which is reported as a clean stop. Keep
# SHUTDOWN_DRAIN_SECONDS + SHUTDOWN_FORCE_EXIT_SECONDS below stop_grace_period.
SHUTDOWN_FORCE_EXIT_SECONDS=10

###### Authentication
# Authentication is opt-in. If neither Basic nor Bearer credentials are set the
# service is public. If any are set, every route except health requires auth.

# Basic auth credentials. Both must be set for Basic auth to be enabled.
# AUTH_BASIC_USER=
# AUTH_BASIC_PASS=

# Comma-separated list of accepted Bearer credentials, each as `name:token`.
# The name identifies the calling service in logs and lets one caller be revoked
# on its own; it is not a secret. Entries without a name are rejected at startup.
# AUTH_BEARER_TOKENS=svc-example:replace-with-a-real-token
